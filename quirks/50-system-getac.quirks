# Do not edit this file, it will be overwritten on update

# Most Pixart Touchpad (093A:0274) devices don't have buttons so we remove right
# button in 30-vendor-pixart.quirks, but this one does.
[Getac X600 Touchpad]
MatchBus=i2c
MatchUdevType=touchpad
MatchVendor=0x093A
MatchProduct=0x0274
MatchDMIModalias=dmi:*:svnGETAC:pnX600*:*
AttrEventCode=+BTN_RIGHT
